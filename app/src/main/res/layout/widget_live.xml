<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Small Parts GF" android:textColor="#9AA3B2" android:textSize="12sp" android:singleLine="true" />
        <TextView android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↻" android:textColor="#9AA3B2" android:textSize="16sp" android:padding="4dp" />
        <TextView android:id="@+id/w_live" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="○ LIVE off" android:textColor="#9AA3B2" android:textSize="12sp" android:textStyle="bold" android:padding="4dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_hour" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Loading…" android:textColor="#E8ECF3" android:textSize="13sp" android:layout_marginTop="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <TextView android:id="@+id/w_pieces" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="–" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_eff" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#3DDC84" android:textSize="26sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/w_prev" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#9AA3B2" android:textSize="11sp" android:singleLine="true" />
        <TextView android:id="@+id/w_foot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#6F7889" android:textSize="10sp" android:singleLine="true" android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
